{
  "name": "dsh-cot-peek",
  "version": "0.2.1",
  "description": "思考小窗：悬浮置顶、可拖可拉、可收起，点一下按钮把 DSH 的思考过程翻成中文。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "market.json",
    "README.md",
    "LICENSE",
    "docs/*.png"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "thinking",
    "chain-of-thought",
    "cot",
    "translation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0",
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wunainana/dsh-cot-peek.git"
  },
  "homepage": "https://github.com/wunainana/dsh-cot-peek#readme",
  "bugs": {
    "url": "https://github.com/wunainana/dsh-cot-peek/issues"
  },
  "author": "wunainana",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
